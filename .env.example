# ==============================================================================
# RED BUCKET BIRYANI – ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# 1. Kitchen Head Admin Initial Credentials
# Used ONLY on first boot to initialize the Kitchen Head account if no account exists.
INITIAL_ADMIN_EMAIL=joelramireddy@gmail.com
INITIAL_ADMIN_PASSWORD=RedBucket@2026

# 2. Cryptographic Session Secret
# Used to sign session tokens statelessly across serverless Lambda instances.
SESSION_SECRET=your-random-32-character-secret-key-here

# 3. Netlify Blobs Persistent Storage (Optional / Auto-injected on Netlify)
# Netlify automatically injects Blobs context in Netlify production.
# Only provide these if accessing Netlify Blobs from a separate external environment.
# NETLIFY_SITE_ID=
# NETLIFY_ACCESS_TOKEN=

# 4. Standalone Server Configuration (If deploying to Render / Railway / VPS)
PORT=3001
NODE_ENV=production
